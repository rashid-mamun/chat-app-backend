# Test Environment Configuration
# This file is used by Jest tests. Never commit real secrets here.

NODE_ENV=test

# JWT - test secrets (short & memorable for testing)
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_REFRESH_SECRET=test-jwt-refresh-secret-key-for-testing-only
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# MongoDB - will be overridden by MongoMemoryServer in tests
MONGO_URI=mongodb://localhost:27017/chatapp-test

# Redis - will be mocked in tests (no real Redis needed)
REDIS_URL=redis://localhost:6379

# Server
PORT=5001
API_VERSION=v1

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# File Upload
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760

# App
APP_NAME=ChatApp-Test
