PORT=5000
NODE_ENV=production
API_VERSION=v1
BACKEND_URL=https://api.example.com
FRONTEND_URL=https://app.example.com

MONGO_URI=mongodb://chatapp:CHANGE_ME@mongo:27017/chatapp?authSource=admin
REDIS_URL=redis://:CHANGE_ME@redis:6379
USE_MEMORY_REDIS=false

# auto prefers BullMQ when REDIS_URL exists, then RabbitMQ, then memory.
QUEUE_DRIVER=bullmq
QUEUE_CONCURRENCY=5
QUEUE_STRICT=false
# RABBITMQ_URL=amqps://user:password@rabbitmq.example.com/vhost

JWT_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_EXPIRE=7d

ALLOWED_ORIGINS=https://app.example.com
LOG_LEVEL=info
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpeg,jpg,png,gif,pdf,doc,docx,txt,plain
UPLOAD_PATH=/app/uploads

RESEND_API_KEY=re_CHANGE_ME
MAIL_FROM=ChatApp <no-reply@your-verified-domain.com>
